{
  "name": "@da-facility/ui",
  "version": "1.1.1",
  "description": "Layouts, templates and components for Da Facility apps, built on Meta Astryx.",
  "keywords": [
    "react",
    "astryx",
    "components",
    "layout",
    "sidebar",
    "toast",
    "design-system"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/da-facility/ui.git"
  },
  "homepage": "https://github.com/da-facility/ui#readme",
  "bugs": {
    "url": "https://github.com/da-facility/ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./locales/*": "./dist/locales/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE.third-party"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "rm -rf dist && vite build --config vite.lib.config.ts && tsc --project tsconfig.lib.json && cp -R src/locales dist/locales",
    "build:catalogue": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "playwright test --project=desktop --project=mobile --project=webkit --project=native-desktop --project=native-mobile",
    "test:headless": "playwright test --project=desktop --project=mobile --project=webkit",
    "test:package": "playwright test --project=package",
    "screenshots": "playwright test --project=screenshots",
    "behaviour:record": "CATALOGUE_PORT=5180 playwright test --project=behaviour-desktop --project=behaviour-mobile --update-snapshots=all --reporter=line",
    "behaviour:compare": "CATALOGUE_PORT=5180 PLAYWRIGHT_HTML_OPEN=never playwright test --project=behaviour-desktop --project=behaviour-mobile --retries=1 --reporter=list,html",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@astryxdesign/core": "^0.5.4 || ^0.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@astryxdesign/build": "^0.6.8",
    "@astryxdesign/core": "0.6.8",
    "@astryxdesign/theme-neutral": "^0.6.8",
    "@heroicons/react": "^2.2.0",
    "@playwright/test": "1.62.1",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/stylex": "^0.19.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@types/bun": "^1.2.19",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^8.1.3"
  },
  "dependencies": {
    "sonner": "^2.0.8"
  }
}
