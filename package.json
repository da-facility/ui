{
  "name": "@da-facility/ui-catalogue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit",
    "test:ui": "bun run scripts/check-library.ts && bun run scripts/check-sidebar-scroll.ts && bun run scripts/check-overscroll.ts",
    "render": "bun run scripts/render.tsx",
    "render:html": "bun run render --format html",
    "render:png": "bun run render --format png",
    "render:jpeg": "bun run render --format jpeg",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@astryxdesign/core": "0.5.4",
    "@astryxdesign/theme-neutral": "^0.5.4",
    "@heroicons/react": "^2.2.0",
    "@stylexjs/stylex": "^0.19.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@astryxdesign/build": "^0.5.4",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@types/bun": "^1.2.19",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.54.2",
    "typescript": "^5.9.2",
    "vite": "^8.1.3"
  }
}
