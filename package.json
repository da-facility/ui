{
  "name": "@da-facility/ui",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build --config vite.library.config.ts && tsc -p tsconfig.build.json",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit",
    "test:ui": "bun run scripts/check-library.ts && bun run scripts/check-sidebar-scroll.ts && bun run scripts/check-overscroll.ts && bun run scripts/check-user-menu.ts && bun run scripts/check-mobile-navigation.ts",
    "render": "bun run scripts/render.tsx",
    "browser:install": "playwright install chromium",
    "build:catalogue": "vite build",
    "prepare": "bun run scripts/prepare.ts",
    "test:package": "bun run scripts/check-package.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "0.5.4",
    "@astryxdesign/theme-neutral": "^0.5.4",
    "@heroicons/react": "^2.2.0",
    "@stylexjs/stylex": "^0.19.0"
  },
  "devDependencies": {
    "@astryxdesign/build": "^0.5.4",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@types/bun": "^1.2.19",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.54.2",
    "typescript": "^5.9.2",
    "vite": "^8.1.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "license": "UNLICENSED",
  "description": "React layouts and components with native scrolling and accessible mobile navigation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/da-facility/ui.git"
  },
  "files": [
    "dist",
    "LICENSE.third-party"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
