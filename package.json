{
  "name": "@da-facility/ui",
  "version": "0.2.0",
  "description": "Layouts, templates and components for Da Facility apps, built on Meta Astryx.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/da-facility/ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE.third-party"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "rm -rf dist && vite build --config vite.lib.config.ts && tsc --project tsconfig.lib.json",
    "build:catalogue": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "playwright test --project=desktop --project=mobile",
    "test:package": "playwright test --project=package",
    "screenshots": "playwright test --project=screenshots",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@astryxdesign/core": "^0.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@astryxdesign/build": "^0.5.4",
    "@astryxdesign/core": "0.5.4",
    "@astryxdesign/theme-neutral": "^0.5.4",
    "@heroicons/react": "^2.2.0",
    "@playwright/test": "1.62.1",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/stylex": "^0.19.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@types/bun": "^1.2.19",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^8.1.3"
  }
}
